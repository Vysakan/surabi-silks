# Uploaded images and reel videos only. Never run scripts from this folder.
Options -Indexes

<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType video/webm .webm
</IfModule>

<FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
