{
  "name": "surabi-silks-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Surabi Silks REST API backend",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "migrate:fresh": "node scripts/migrate.js --fresh",
    "test": "node --experimental-vm-modules node_modules/vitest/vitest.mjs run",
    "test:watch": "node --experimental-vm-modules node_modules/vitest/vitest.mjs watch"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.14.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.1.0",
    "vitest": "^3.2.1"
  }
}
